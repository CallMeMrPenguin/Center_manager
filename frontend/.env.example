# =========================================================================
# Center Manager — Frontend Environment Configuration
# =========================================================================

# 1. API Base URL:
# - Leave EMPTY when developing locally (Vite proxies /api to http://localhost:8000)
# - Set to your deployed Vercel Backend URL on production (e.g. https://your-backend.vercel.app)
VITE_API_URL=

# 2. App Mode:
# - 'local': Shows all tabs including offline Question Bank, Vocabulary Bank, Test Formatter, and Local File Manager.
# - 'web': Hides offline-only local tabs and optimizes the UI for mobile/cloud management.
VITE_APP_MODE=local
